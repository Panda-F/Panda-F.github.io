---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | escape }}</title>
  <subtitle>{{ site.description | escape }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  {% set posts = collections.posts | reverse %}
  <updated>{{ (posts[0].date if posts.length else site.started) | isoDate }}</updated>
  <author><name>{{ site.author }}</name></author>
  {% for post in posts %}
  <entry>
    <title>{{ post.data.title | escape }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <updated>{{ post.date | isoDate }}</updated>
    {% if post.data.description %}<summary>{{ post.data.description | escape }}</summary>{% endif %}
    <content type="html">{{ post.content | escape }}</content>
  </entry>
  {% endfor %}
</feed>
