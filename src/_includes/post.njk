---
layout: base.njk
---
<article class="essay">
  <header class="essay-head">
    <time datetime="{{ page.date | isoDate }}">{{ page.date | shortDate }}</time>
    <h1>{{ title | escape }}</h1>
    {% if description %}<p class="lede">{{ description | escape }}</p>{% endif %}
  </header>
  <div class="prose">{{ content | safe }}</div>
</article>
